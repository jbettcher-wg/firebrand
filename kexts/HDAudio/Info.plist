<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>		<string>English</string>
	<key>CFBundleExecutable</key>			<string>HDAudio</string>
	<key>CFBundleIdentifier</key>			<string>io.github.jbettcher-wg.HDAudio</string>
	<key>CFBundleInfoDictionaryVersion</key>	<string>6.0</string>
	<key>CFBundleName</key>				<string>HDAudio</string>
	<key>CFBundlePackageType</key>			<string>KEXT</string>
	<key>CFBundleSignature</key>			<string>????</string>
	<key>CFBundleVersion</key>			<string>1.1.0</string>
	<key>OSBundleLibraries</key>
	<dict>
		<!-- KPI version 8.0: Mac OS X 10.4 and later. -->
		<key>com.apple.kpi.iokit</key>		<string>8.0</string>
		<key>com.apple.kpi.libkern</key>	<string>8.0</string>
		<key>com.apple.kpi.mach</key>		<string>8.0</string>
		<key>com.apple.kpi.unsupported</key>	<string>8.0</string>
		<key>com.apple.iokit.IOPCIFamily</key>	<string>2.6</string>
		<!-- 1.6.9fc5 on Mac OS X 10.5.8, compatible back to 1.1d25. -->
		<key>com.apple.iokit.IOAudioFamily</key>	<string>1.1fc9</string>
	</dict>
	<key>IOKitPersonalities</key>
	<dict>
		<key>HDAudio</key>
		<dict>
			<key>CFBundleIdentifier</key>	<string>io.github.jbettcher-wg.HDAudio</string>
			<key>IOClass</key>		<string>HDAudioDevice</string>
			<key>IOProviderClass</key>	<string>IOPCIDevice</string>
			<!-- Any HD Audio controller (class 04, subclass 03). Nothing
			     else on this root drives one: AppleHDA is i386-only on
			     Leopard. Which card supplies it is read from the boot
			     survey, never written here. -->
			<key>IOPCIClassMatch</key>	<string>0x04030000&amp;0xffff0000</string>
			<key>IOProbeScore</key>		<integer>1000</integer>
			<!-- DMA addresses from IODMACommand (kexts/common/qoriq_dma.h)
			     instead of physical + inbound window 2. On by default since
			     2026-11-14; boot-arg qdmacmd=0 turns it off. -->
			<key>QorIQDMACommand</key>	<true/>
		</dict>
	</dict>
</dict>
</plist>
