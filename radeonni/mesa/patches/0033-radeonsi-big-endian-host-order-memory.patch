+/*
+ * osx-gpu: on a big-endian host a texture holds the GPU's own layout,
+ * little-endian words for every format wider than bytes, so the sampler, the
+ * colour buffer and the compute blits read and write it natively. Mesa's
+ * format code and the application see the host-order layout, which exists
+ * only in the CPU's view: such a texture is always mapped through a staging
+ * texture, swapped unit by unit after the copy in and before the copy out
+ * (si_be_swap_unit, si_state.h). Measured on the W8100, 2026-11-04: Core
+ * Image's RGBA16 and float pbuffers, which the window server composites
+ * with, are what this is for.
+ */
+static void si_be_swap_box(void *map, unsigned unit, enum pipe_format format,
+                           const struct pipe_box *box, unsigned stride, unsigned layer_stride)
+{
+   unsigned rows = util_format_get_nblocksy(format, box->height);
+   unsigned bytes = util_format_get_stride(format, box->width);
+
+   for (unsigned z = 0; z < box->depth; z++) {
+      for (unsigned y = 0; y < rows; y++) {
+         char *row = (char *)map + (size_t)z * layer_stride + (size_t)y * stride;
+
+         switch (unit) {
+         case 2:
+            for (unsigned i = 0; i + 2 <= bytes; i += 2) {
+               uint16_t v;
+               memcpy(&v, row + i, 2);
+               v = util_bswap16(v);
+               memcpy(row + i, &v, 2);
+            }
+            break;
+         case 4:
+            for (unsigned i = 0; i + 4 <= bytes; i += 4) {
+               uint32_t v;
+               memcpy(&v, row + i, 4);
+               v = util_bswap32(v);
+               memcpy(row + i, &v, 4);
+            }
+            break;
+         case 8:
+            for (unsigned i = 0; i + 8 <= bytes; i += 8) {
+               uint64_t v;
+               memcpy(&v, row + i, 8);
+               v = util_bswap64(v);
+               memcpy(row + i, &v, 8);
+            }
+            break;
+         default:
+            break;
+         }
+      }
+   }
+}
