+
+/*
+ * osx-gpu: application memory on a big-endian host.
+ *
+ * Mesa's convention on a big-endian host is that a buffer holds host-order
+ * data: a float uniform is four bytes with the most significant first, which
+ * is what the application wrote and what a CPU readback expects. The shader
+ * engines load and store little-endian, so every application load of a
+ * 16-, 32- or 64-bit element is byte-swapped after the load, and every store
+ * before it. A 64-bit element also swaps its two words. The vertex fetch
+ * does the same in si_nir_lower_vs_inputs.c, the colour buffer swaps in
+ * hardware (CB_COLOR_INFO.ENDIAN) and descriptors are uploaded little-endian
+ * (si_descriptors.c), so those are not touched here. radeonsi's own shaders
+ * (si_create_shader_state, which names them "si_internal:...") work on data
+ * the hardware or the driver wrote and are left alone; the state tracker's
+ * helper shaders read what it uploaded, host-order, and are not exempt. Measured on the W8100, 2026-11-04: without this the
+ * fixed-function matrices arrived byte-reversed and no vertex was on screen.
+ */
+nir_def *si_nir_be_swap(nir_builder *b, nir_def *x)
+{
+   switch (x->bit_size) {
+   case 16:
+      return nir_ior(b, nir_ishl_imm(b, nir_iand_imm(b, x, 0xff), 8), nir_ushr_imm(b, x, 8));
+   case 32:
+      return nir_ior(b,
+                     nir_ior(b, nir_ishl_imm(b, x, 24),
+                             nir_ishl_imm(b, nir_iand_imm(b, x, 0xff00), 8)),
+                     nir_ior(b, nir_iand_imm(b, nir_ushr_imm(b, x, 8), 0xff00),
+                             nir_ushr_imm(b, x, 24)));
+   case 64: {
+      nir_def *lo = si_nir_be_swap(b, nir_unpack_64_2x32_split_x(b, x));
+      nir_def *hi = si_nir_be_swap(b, nir_unpack_64_2x32_split_y(b, x));
+      return nir_pack_64_2x32_split(b, hi, lo);
+   }
+   default:
+      return x;
+   }
+}
+
+static bool si_nir_be_swap_mem_access(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_ubo:
+   case nir_intrinsic_load_ssbo:
+   case nir_intrinsic_load_global:
+   case nir_intrinsic_load_global_constant:
+   case nir_intrinsic_load_constant: {
+      if (intr->def.bit_size < 16)
+         return false;
+      b->cursor = nir_after_instr(&intr->instr);
+      nir_def *swapped = si_nir_be_swap(b, &intr->def);
+      nir_def_rewrite_uses_after(&intr->def, swapped);
+      return true;
+   }
+   case nir_intrinsic_store_ssbo:
+   case nir_intrinsic_store_global: {
+      if (intr->src[0].ssa->bit_size < 16)
+         return false;
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_src_rewrite(&intr->src[0], si_nir_be_swap(b, intr->src[0].ssa));
+      return true;
+   }
+   default:
+      return false;
+   }
+}
+
+bool si_nir_host_order_memory(const nir_shader *nir)
+{
+   return UTIL_ARCH_BIG_ENDIAN &&
+          !(nir->info.name && strncmp(nir->info.name, "si_internal:", 12) == 0);
+}
+
+bool si_nir_lower_be_memory(nir_shader *nir)
+{
+   if (!si_nir_host_order_memory(nir))
+      return false;
+
+   return nir_shader_intrinsics_pass(nir, si_nir_be_swap_mem_access,
+                                     nir_metadata_control_flow, NULL);
+}
