+++ b/src/gallium/drivers/radeonsi/si_state.h
@@ -9,6 +9,8 @@
 
 #include "si_pm4.h"
 #include "util/format/u_format.h"
+#include <stdlib.h>
+#include <string.h>
 
 #ifdef __cplusplus
 extern "C" {
@@ -347,6 +349,96 @@ static inline unsigned si_sampler_and_image_descriptors_idx(unsigned shader)
 /* This represents descriptors in memory, such as buffer resources,
  * image resources, and sampler states.
  */
+/*
+ * osx-gpu: on a big-endian host, the unit (in bytes) by which a format's
+ * host-order layout, the one Mesa's format code lays out and reads
+ * (u_format_table.c), differs from the GPU's little-endian one: 0 for
+ * formats with 8-bit channels and for compressed blocks, which are bytes in
+ * the same order on either, the channel for 16-, 32- and 64-bit channels,
+ * the word for packed formats. Textures keep the GPU's layout and are
+ * swapped by this unit at the CPU boundary (si_texture.c); buffers are
+ * host-order and are swapped by the shaders, which no sampler can do, so a
+ * buffer is not offered as a texture or image through a non-native format.
+ */
+static inline unsigned si_be_swap_unit(enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   unsigned size = 0;
+
+   if (!UTIL_ARCH_BIG_ENDIAN)
+      return 0;
+   /*
+    * osx-gpu: the two packed float formats are not "plain", but Mesa packs
+    * them into a host-order word like any packed format (u_format_other.c,
+    * texstore), and the GPU reads a little-endian one.
+    */
+   if (format == PIPE_FORMAT_R11G11B10_FLOAT || format == PIPE_FORMAT_R9G9B9E5_FLOAT)
+      return 4;
+   if (desc->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return 0;
+   for (unsigned i = 0; i < desc->nr_channels; i++) {
+      if (desc->channel[i].type == UTIL_FORMAT_TYPE_VOID)
+         continue;
+      if (size && size != desc->channel[i].size)
+         return desc->block.bits > 8 ? MIN2(desc->block.bits / 8, 4) : 0;
+      size = desc->channel[i].size;
+   }
+   /*
+    * osx-gpu: a channel that is not a whole power-of-two number of bytes
+    * (5, 10, and 24 in Z24X8/X8Z24) is a field of a packed word.
+    */
+   if (size % 8 || size == 24)
+      return desc->block.bits > 8 ? MIN2(desc->block.bits / 8, 4) : 0;
+   return size > 8 ? size / 8 : 0;
+}
+
+static inline bool si_be_format_native(enum pipe_format format)
+{
+   return si_be_swap_unit(format) == 0;
+}
+
+/*
+ * osx-gpu: a plain format whose channels are not all whole bytes of one
+ * size (5_6_5, 4_4_4_4, 2_10_10_10, 24_8, ...). On a big-endian host Mesa
+ * lists the channels of these formats from the top bits down
+ * (u_format_parse.py), and the hardware was first programmed from that
+ * listing, with the channels reversed (measured: all nine of rdn_gltest
+ * -K's packed uploads came back that way), so they were withheld and the
+ * state tracker converted them on the CPU. Part six programs the hardware
+ * from the little-endian listing (ac_format_description) and the CPU's
+ * host-order words are swapped by si_be_swap_unit at the staging boundary,
+ * so they are offered; RDN_BE_PACKED=0 in the environment withholds them
+ * again.
+ */
+static inline bool si_be_withhold_packed(void)
+{
+   static int withhold = -1;
+
+   if (withhold < 0) {
+      const char *v = getenv("RDN_BE_PACKED");
+
+      withhold = v && (!strcmp(v, "0") || !strcmp(v, "false") || !strcmp(v, "no"));
+   }
+   return withhold;
+}
+
+static inline bool si_be_format_packed(enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   unsigned size = 0;
+
+   if (desc->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return false;
+   for (unsigned i = 0; i < desc->nr_channels; i++) {
+      if (desc->channel[i].type == UTIL_FORMAT_TYPE_VOID)
+         continue;
+      if ((size && size != desc->channel[i].size) || desc->channel[i].size % 8)
+         return true;
+      size = desc->channel[i].size;
+   }
+   return false;
+}
+
