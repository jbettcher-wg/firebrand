+/* osx-gpu: GFX8 on a big-endian host, a byte-swapped copy of 16- or 32-bit indices (si_shaderlib_nir.c). */
+void si_compute_swap_index_buffer(struct si_context *sctx, struct pipe_resource *dst, struct pipe_resource *src,
+                                  uint64_t dst_offset, uint64_t src_offset, unsigned count,
+                                  unsigned index_size, bool render_condition_enable)
+{
+   void **cs = &sctx->cs_index_swap[index_size == 4];
+
+   if (!count)
+      return;
+
+   if (!*cs)
+      *cs = si_create_index_swap_compute_shader(sctx, index_size);
+
+   struct pipe_grid_info info = {};
+   set_work_size(&info, 64, 1, 1, count, 1, 1);
+
+   struct pipe_shader_buffer sb[2] = {};
+   sb[0].buffer = dst;
+   sb[0].buffer_offset = dst_offset;
+   sb[0].buffer_size = count * index_size;
+
+   sb[1].buffer = src;
+   sb[1].buffer_offset = src_offset;
+   sb[1].buffer_size = count * index_size;
+
+   si_launch_grid_internal_ssbos(sctx, &info, *cs, 2, sb, 0x1, render_condition_enable);
+}
