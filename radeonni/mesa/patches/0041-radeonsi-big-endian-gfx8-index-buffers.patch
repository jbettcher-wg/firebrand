+/*
+ * osx-gpu: GFX8 on a big-endian host (patch 0041): the index fetch needs a
+ * byte-swapped copy of a buffer object's indices. Made per draw, that is a
+ * compute dispatch and a new buffer for every indexed draw, which draw-heavy
+ * programs (WebGL) feel. So each index buffer keeps one copy, the whole
+ * buffer swapped by one dispatch, until it is written:
+ *  - a CPU write map (si_buffer_transfer_map, buffer_subdata), new storage
+ *    (si_alloc_resource, si_replace_buffer_storage) and every GPU write
+ *    radeonsi makes through si_barrier_after_internal_op (copies, clears)
+ *    mark it stale, and the next draw swaps the buffer again;
+ *  - a buffer that may change without radeonsi seeing it (persistently
+ *    mapped, glthread's upload buffers included), that shaders or streamout
+ *    may write (bound as an SSBO, image or streamout target), that is big,
+ *    or that went stale too often, is swapped per draw instead: only the
+ *    range the draw reads, into the stream uploader, not a buffer of its
+ *    own (a buffer per draw sized to the range's END ran a glthread upload
+ *    buffer out of video memory, 2026-11-13, frb_glbench draws-c);
+ *  - the copy is used only by the context that made it, whose command
+ *    stream holds the dispatch before the draws that read it.
+ */
+#define SI_BE_INDEX_SWAP_CACHE_MAX     (16u * 1024 * 1024)
+#define SI_BE_INDEX_SWAP_MAX_REWRITES  8
+#define SI_BE_INDEX_SWAP_CPU_MAX       16384u   /* indices swapped on the CPU from a live mapping */
+
+static struct pipe_resource *si_be_index_swap_cached(struct si_context *sctx, struct si_resource *src,
+                                                     unsigned index_size)
+{
+   if (src->bind_history & (SI_BIND_SHADER_BUFFER_ALL | SI_BIND_IMAGE_BUFFER_ALL |
+                            SI_BIND_STREAMOUT_BUFFER))
+      src->be_index_swap_nocache = true;
+   if (src->be_index_swap_nocache || src->b.b.width0 > SI_BE_INDEX_SWAP_CACHE_MAX ||
+       src->b.b.width0 < index_size || (src->be_index_swap_ctx && src->be_index_swap_ctx != sctx))
+      return NULL;
+   /* osx-gpu (mapped index buffers): CPU writes are seen through the mapping counters, not
+    * through be_index_swap_dirty alone: with the threaded context or glthread
+    * the mapping thread runs ahead of this one, so a flag set at map time can
+    * be cleared here before the data is written, and a buffer that stays
+    * mapped (glthread's upload buffers) is written with no map call at all.
+    * _seq is read before _maps: when no mapping exists, every write counted
+    * in seq is complete, and a later one steps _seq again. */
+   uint32_t seq = p_atomic_read(&src->be_index_swap_seq);
+   if (p_atomic_read(&src->be_index_swap_maps))
+      return NULL;   /* being written: swap per draw */
+   if (seq != src->be_index_swap_seq_done)
+      src->be_index_swap_dirty = true;
+   if (src->be_index_swap && !src->be_index_swap_dirty && src->be_index_swap_size == index_size)
+      return src->be_index_swap;
+   if (src->be_index_swap && src->be_index_swap_dirty &&
+       ++src->be_index_swap_rewrites > SI_BE_INDEX_SWAP_MAX_REWRITES) {
+      /* written over and over: a streaming buffer */
+      src->be_index_swap_nocache = true;
+      pipe_resource_reference(&src->be_index_swap, NULL);
+      return NULL;
+   }
+   if (!src->be_index_swap || src->be_index_swap->width0 != src->b.b.width0) {
+      pipe_resource_reference(&src->be_index_swap, NULL);
+      src->be_index_swap = pipe_buffer_create(&sctx->screen->b, 0, PIPE_USAGE_DEFAULT,
+                                              src->b.b.width0);
