+/*
+ * osx-gpu: GFX8 on a big-endian host. An index buffer holds host-order
+ * indices, and GFX8 fetches them through L2 little-endian: VGT_DMA_INDEX_TYPE's
+ * SWAP_MODE, which GFX6-7 honour, is ignored there (measured on Polaris 12,
+ * Firebrand's E9173, 2026-11-13: every value 0-3, through INDEX_TYPE and as a
+ * context register, drew 16- and 32-bit indices alike, wrongly; indices
+ * stored little-endian drew right). So the draw takes a copy with each index
+ * byte-swapped, made by this shader (index_size 2 or 4, one index per
+ * invocation). Internal, so si_nir_lower_be_memory leaves its loads alone.
+ */
+void *si_create_index_swap_compute_shader(struct si_context *sctx, unsigned index_size)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, sctx->screen->nir_options,
+                                                  index_size == 4 ? "index_swap32" : "index_swap16");
+   b.shader->info.workgroup_size[0] = 64;
+   b.shader->info.workgroup_size[1] = 1;
+   b.shader->info.workgroup_size[2] = 1;
+   b.shader->info.num_ssbos = 2;
+
+   nir_def *address = nir_imul_imm(&b, ac_get_global_ids(&b, 1, 32), index_size);
+   nir_def *value = nir_load_ssbo(&b, 1, index_size * 8, nir_imm_int(&b, 1), address,
+                                  .access = ACCESS_RESTRICT);
+   nir_store_ssbo(&b, si_nir_be_swap(&b, value), nir_imm_int(&b, 0), address,
+                  .access = ACCESS_RESTRICT);
+
+   return si_create_shader_state(sctx, b.shader);
+}
