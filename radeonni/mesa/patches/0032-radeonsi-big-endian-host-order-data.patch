  * - size = 8 bytes, format = fixed indicates PIPE_FORMAT_R11G11B10_FLOAT
  * - size = 8 bytes, format != {float,fixed} indicates a 2_10_10_10 data format
  */
+/* osx-gpu: byte swaps for host-order vertex data read as little-endian words. */
+static nir_def *
+rdn_bswap32(nir_builder *b, nir_def *x)
+{
+   return nir_ior(b,
+                  nir_ior(b, nir_ishl_imm(b, x, 24), nir_ishl_imm(b, nir_iand_imm(b, x, 0xff00), 8)),
+                  nir_ior(b, nir_iand_imm(b, nir_ushr_imm(b, x, 8), 0xff00), nir_ushr_imm(b, x, 24)));
+}
+
+static nir_def *
+rdn_bswap16(nir_builder *b, nir_def *x)
+{
+   return nir_ior(b, nir_ishl_imm(b, nir_iand_imm(b, x, 0xff), 8), nir_ushr_imm(b, x, 8));
+}
+
 static void
 opencoded_load_format(nir_builder *b, nir_def *rsrc, nir_def *vindex,
                       union si_vs_fix_fetch fix_fetch, bool known_aligned,
