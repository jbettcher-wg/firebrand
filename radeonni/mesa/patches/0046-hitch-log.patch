osx-gpu: RDN_HITCH_LOG, where a long frame's time went

A program that runs smoothly and then stops for a tenth of a second or more
when something new comes into view (Doom 3, T4240, 2026-11-15) raises the
question of whose time that is: a shader compiled or waited for at a draw, a
texture or buffer uploaded, the program's thread waiting for glthread, or
glthread for the driver's thread -- or none of them, and the program's own.

RDN_HITCH_LOG=<ms> in the environment (1: 2 ms) prints one line to stderr,
with the wall clock's time, for each of these that took at least that long:

  shader-variant at-draw|async   si_create_shader_variant (stage, optimized)
  shader-main-part async         a shader's main part on the compiler queue
  shader-wait main-part-at-draw  a draw waiting for that queue
  tex-upload, tex-upload-compressed   st_TexSubImage and its compressed twin
  buffer-data, buffer-subdata    glBufferData/glBufferSubData in the driver
  glthread-sync <call>           the program's thread waiting for glthread
  glthread-queue-full            the same, with glthread eight batches behind
  tc-sync <function>             a wait for the driver's thread
  tc-queue-full                  glthread waiting to queue a batch to it

The GL bundle adds a line for every frame out of step with its neighbours
and the spread of all frames' times when the program ends (gld/rdn_mesa.c),
and the OSMesa frontend the wait for the swap before (swap-wait). Unset, each
site costs one compare.

--- /dev/null
+++ b/src/util/rdn_hitch.h
@@ -0,0 +1,59 @@
+/*
+ * osx-gpu: where a frame's time went when one frame takes far longer than
+ * its neighbours. RDN_HITCH_LOG=<ms> in the environment (1: 2 ms) prints one
+ * line to stderr for every instrumented step that took at least that long:
+ * a shader compiled or waited for at a draw, a texture or buffer upload, a
+ * wait of the program's thread for glthread or of glthread for the driver
+ * thread. The time is the wall clock's, as the GL bundle's frame lines use.
+ */
+#ifndef RDN_HITCH_H
+#define RDN_HITCH_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/time.h>
+
+static inline double
+rdn_hitch_now(void)
+{
+   struct timeval tv;
+
+   gettimeofday(&tv, NULL);
+   return tv.tv_sec + tv.tv_usec / 1e6;
+}
+
+/* The threshold in seconds; 0: off. */
+static inline double
+rdn_hitch_threshold(void)
+{
+   static double threshold = -1;
+
+   if (threshold < 0) {
+      const char *env = getenv("RDN_HITCH_LOG");
+      double ms = env ? atof(env) : 0;
+
+      threshold = !env ? 0 : (ms > 1 ? ms : 2) / 1e3;
+   }
+   return threshold;
+}
+
+static inline double
+rdn_hitch_begin(void)
+{
+   return rdn_hitch_threshold() > 0 ? rdn_hitch_now() : 0;
+}
+
+static inline void
+rdn_hitch_end(double t0, const char *what, const char *detail, long a, long b)
+{
+   double t1;
+
+   if (t0 == 0)
+      return;
+   t1 = rdn_hitch_now();
+   if (t1 - t0 >= rdn_hitch_threshold())
+      fprintf(stderr, "rdn-hitch %.3f %s %s %ld %ld: %.1f ms\n", t1, what,
+              detail ? detail : "", a, b, (t1 - t0) * 1e3);
+}
+
+#endif
