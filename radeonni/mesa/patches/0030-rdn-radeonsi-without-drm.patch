diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -1002,6 +1002,15 @@
 if with_gfx_compute
   pre_args += '-DHAVE_GFX_COMPUTE'
 endif
+# osx-gpu: no DRM device library behind radeonsi; ac_linux_drm takes its
+# Windows shape (types defined, every ac_drm_* call an inline stub).
+if get_option('rdn')
+  pre_args += '-DAC_NO_DRM'
+  # addrlib keeps Apple-only branches for Apple's own driver (a private
+  # header, a kernel __umoddi3); HAVE_TSERVER is its own switch to the
+  # generic code, which is what a userland Mach-O wants.
+  pre_args += '-DHAVE_TSERVER'
+endif
 
 gl_pkgconfig_c_flags = []
 with_glx_indirect_rendering = false
@@ -1897,7 +1906,8 @@
 
 _libdrm_checks = [
   ['intel', with_gallium_i915],
-  ['amdgpu', (with_amd_vk and not with_platform_windows) or with_gallium_radeonsi],
+  # osx-gpu: radeonsi on the rdn winsys needs no libdrm_amdgpu.
+  ['amdgpu', (with_amd_vk and not with_platform_windows) or (with_gallium_radeonsi and not get_option('rdn'))],
 ]
 
 # Loop over the enables versions and get the highest libdrm requirement for all
@@ -2145,7 +2155,7 @@
 endif
 if dep_elf.found()
   pre_args += '-DUSE_LIBELF'
-elif with_gallium_radeonsi and with_gfx_compute
+elif with_gallium_radeonsi and with_gfx_compute and not get_option('rdn')
   error('Gallium driver radeonsi requires libelf')
 elif with_nouveau_vk
   error('NVK requires libelf')
