diff --git a/src/amd/common/ac_formats.c b/src/amd/common/ac_formats.c
--- a/src/amd/common/ac_formats.c
+++ b/src/amd/common/ac_formats.c
@@ -10,6 +10,73 @@
 #include "ac_gpu_info.h"
 
 #include "amdgfxregs.h"
+#include "util/u_call_once.h"
+#include "util/u_endian.h"
+
+#if UTIL_ARCH_BIG_ENDIAN
+/*
+ * osx-gpu: little-endian listings of the bitmask formats (5_6_5, 4_4_4_4,
+ * 1_5_5_5, 2_10_10_10, 24_8, ...). u_format_parse.py reverses their
+ * channels and remaps their swizzles on a big-endian host and numbers the
+ * shifts from the other end, so each channel keeps its bits; undo the
+ * reversal so that channel 0 is the lowest bits again, as the hardware
+ * tables (and every caller below) expect. r600 needed the same
+ * (mesa/patches/0006).
+ */
+static struct util_format_description ac_le_formats[PIPE_FORMAT_COUNT];
+static util_once_flag ac_le_formats_once = UTIL_ONCE_FLAG_INIT;
+
+static void
+ac_le_formats_init(void)
+{
+   for (unsigned f = 0; f < PIPE_FORMAT_COUNT; f++) {
+      const struct util_format_description *desc = util_format_description(f);
+      struct util_format_description *le = &ac_le_formats[f];
+      unsigned n = 0;
+
+      if (!desc)
+         continue;
+      *le = *desc;
+      if (desc->layout != UTIL_FORMAT_LAYOUT_PLAIN || !desc->is_bitmask || desc->is_array)
+         continue;
+      for (unsigned i = 0; i < 4; i++)
+         if (desc->channel[i].size)
+            n++;
+      for (unsigned i = 0; i < n; i++)
+         le->channel[i] = desc->channel[n - 1 - i];
+      for (unsigned i = 0; i < 4; i++)
+         if (desc->swizzle[i] <= PIPE_SWIZZLE_W && desc->swizzle[i] < n)
+            le->swizzle[i] = n - 1 - desc->swizzle[i];
+   }
+}
+#endif
+
+const struct util_format_description *
+ac_format_description(enum pipe_format format)
+{
+   const struct util_format_description *desc = util_format_description(format);
+
+#if UTIL_ARCH_BIG_ENDIAN
+   if (desc && desc->layout == UTIL_FORMAT_LAYOUT_PLAIN && desc->is_bitmask && !desc->is_array) {
+      util_call_once(&ac_le_formats_once, ac_le_formats_init);
+      return &ac_le_formats[format];
+   }
+#endif
+   return desc;
+}
+
+int
+ac_format_first_non_void_channel(enum pipe_format format)
+{
+   const struct util_format_description *desc = ac_format_description(format);
+
+   if (!desc)
+      return -1;
+   for (unsigned i = 0; i < 4; i++)
+      if (desc->channel[i].type != UTIL_FORMAT_TYPE_VOID)
+         return i;
+   return -1;
+}
 
 uint32_t
 ac_translate_buffer_numformat(const struct util_format_description *desc,
@@ -447,7 +514,7 @@ ac_translate_tex_dataformat(const struct radeon_info *info,
 unsigned
