+        UINT_32 swMiscDef13 : 1;
+        UINT_32 swMiscDef12 : 1;
+        UINT_32 sw64KB_R    : 1;
+        UINT_32 sw64KB_D    : 1;
+        UINT_32 sw64KB_S    : 1;
