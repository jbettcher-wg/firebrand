+        UINT_32 sw256B_R    : 1;
+        UINT_32 sw256B_D    : 1;
+        UINT_32 sw256B_S    : 1;
+        UINT_32 swLinear    : 1;
+#else
         UINT_32 swLinear    : 1;
         UINT_32 sw256B_S    : 1;
         UINT_32 sw256B_D    : 1;
@@ -4051,23 +4127,39 @@
         UINT_32 swMiscDef29 : 1;
         UINT_32 swMiscDef30 : 1;
         UINT_32 swMiscDef31 : 1;
+#endif
     };
 
     struct
